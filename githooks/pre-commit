#!/bin/sh

# pre-commit hook
# pyproject.tomlのパッチバージョンをバンプし、pictogram/package.jsonを同期させる

if command -v uv >/dev/null 2>&1; then
    uv run python scripts/update_versions.py
else
    python scripts/update_versions.py
fi

# 戻り値チェック
if [ $? -ne 0 ]; then
    echo "Error: Failed to update versions"
    exit 1
fi

# 変更をステージする
git add pyproject.toml
git add pictogram/package.json

exit 0
