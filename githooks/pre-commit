#!/bin/sh

# pre-commit hook
# pyproject.toml のパッチバージョンをバンプアップする

if command -v uv >/dev/null 2>&1; then
    uv run python scripts/update_versions.py
else
    python scripts/update_versions.py
fi

if [ $? -ne 0 ]; then
    echo "Error: Failed to bump version in pyproject.toml"
    exit 1
fi

git add pyproject.toml

exit 0
