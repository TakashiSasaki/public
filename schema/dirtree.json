{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://purl.org/gag/schema/dirtree.json",
    "title": "Directory Tree Schema",
    "description": "A recursive tree structure representing filesystem directories and files, where object keys are path segments and values are either null (leaf nodes) or nested tree objects (directories with contents).",
    "type": "object",
    "required": [
        "@context",
        "dirtree",
        "observer",
        "observedAtTime"
    ],
    "properties": {
        "@context": {
            "const": "https://purl.org/gag/schema/dirtree.jsonld",
            "description": "Fixed JSON-LD context URI for GAG Directory Tree"
        },
        "observedAtTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the scan"
        },
        "dirtree": {
            "$ref": "#/definitions/treeNode"
        },
        "observer": {
            "type": "object",
            "properties": {
                "uid": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "userPrincipalName": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        }
    },
    "definitions": {
        "treeNode": {
            "anyOf": [
                {
                    "type": "null",
                    "description": "A leaf node representing a file or empty directory"
                },
                {
                    "type": "object",
                    "description": "A directory node containing child nodes",
                    "patternProperties": {
                        "^[^/\\*?\"<>|]+$": {
                            "$ref": "#/definitions/treeNode"
                        }
                    },
                    "additionalProperties": false
                }
            ]
        }
    }
}