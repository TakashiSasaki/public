{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://purl.org/gag/schema/probe.json",
    "title": "Probe Output (JSON-LD)",
    "description": "Standard output format for get-a-grip probe containing identity and system information.",
    "type": "object",
    "required": [
        "@context",
        "@type",
        "observer",
        "target",
        "observedAtTime"
    ],
    "properties": {
        "@context": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "observedAtTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the probe"
        },
        "@type": {
            "const": "ProbeResult"
        },
        "observer": {
            "type": "object",
            "required": [
                "uid"
            ],
            "properties": {
                "uid": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "userPrincipalName": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "target": {
            "type": "object",
            "required": [
                "sysName",
                "osName"
            ],
            "properties": {
                "sysName": {
                    "type": "string"
                },
                "platform": {
                    "type": "string"
                },
                "osName": {
                    "type": "string"
                },
                "osVersion": {
                    "type": "string"
                },
                "osBuild": {
                    "type": "string"
                },
                "osArchitecture": {
                    "type": "string"
                },
                "kernelVersion": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "baseboard": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "properties": {
                        "manufacturer": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "product": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                },
                "totalPhysicalMemory": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "logicalDisks": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "deviceId": {
                                "type": "string"
                            },
                            "size": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "freeSpace": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            }
                        }
                    }
                }
            }
        }
    }
}