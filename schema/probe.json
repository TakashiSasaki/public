{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://purl.org/gag/schema/probe.json",
    "title": "Probe Output (JSON-LD)",
    "description": "Standard output format for get-a-grip probe containing identity and system information.",
    "type": "object",
    "required": [
        "@context",
        "@type"
    ],
    "properties": {
        "@context": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "@type": {
            "const": "ProbeResult"
        },
        "uid": {
            "type": [
                "string",
                "null"
            ]
        },
        "userPrincipalName": {
            "type": [
                "string",
                "null"
            ]
        },
        "sysName": {
            "type": "string"
        },
        "platform": {
            "type": "string"
        },
        "osName": {
            "type": "string"
        },
        "osVersion": {
            "type": "string"
        },
        "osBuild": {
            "type": "string"
        },
        "osArchitecture": {
            "type": "string"
        },
        "kernelVersion": {
            "type": [
                "string",
                "null"
            ]
        },
        "baseboard": {
            "type": [
                "object",
                "null"
            ],
            "properties": {
                "manufacturer": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "product": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "totalPhysicalMemory": {
            "type": [
                "integer",
                "null"
            ]
        },
        "logicalDisks": {
            "type": "array",
            "items": {
                "object": {
                    "type": "object",
                    "properties": {
                        "deviceId": {
                            "type": "string"
                        },
                        "size": {
                            "type": [
                                "integer",
                                "null"
                            ]
                        },
                        "freeSpace": {
                            "type": [
                                "integer",
                                "null"
                            ]
                        }
                    }
                }
            }
        }
    }
}