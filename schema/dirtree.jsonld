{
    "@id": "https://purl.org/gag/schema/dirtree.jsonld",
    "@context": {
        "@vocab": "https://purl.org/gag/schema/vocab#",
        "gag": "https://purl.org/gag/schema/vocab#",
        "schema": "https://schema.org/",
        "ldap": "https://purl.org/net/ldap#",
        "ad": "https://purl.org/identity/ad/",
        "uid": "ldap:uid",
        "userPrincipalName": "ad:userPrincipalName",
        "observer": "gag:observer",
        "observedAtTime": "gag:observedAtTime",
        "dirtree": {
            "@id": "gag:dirtree",
            "@type": "gag:DirectoryTree",
            "@container": "@index"
        }
    }
}