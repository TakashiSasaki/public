{
    "@id": "https://purl.org/gag/schema/vocab",
    "@context": {
        "gag": "https://purl.org/gag/schema/vocab#",
        "schema": "https://schema.org/",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "owl": "http://www.w3.org/2002/07/owl#",
        "prov": "http://www.w3.org/ns/prov#",
        "earl": "http://www.w3.org/ns/earl#"
    },
    "@graph": [
        {
            "@id": "https://purl.org/gag/schema/vocab#",
            "@type": "owl:Ontology",
            "rdfs:label": "GAG Vocabulary",
            "rdfs:comment": "get-a-grip プロジェクトその他のための語彙定義。"
        },
        {
            "@id": "gag:files",
            "@type": "owl:ObjectProperty",
            "rdfs:label": "files",
            "rdfs:comment": "A collection of file objects (mapped to schema:MediaObject).",
            "rdfs:range": {
                "@id": "schema:MediaObject"
            }
        },
        {
            "@id": "gag:directories",
            "@type": "owl:ObjectProperty",
            "rdfs:label": "directories",
            "rdfs:comment": "A collection of directory structures (mapped to schema:ItemList).",
            "rdfs:range": {
                "@id": "schema:ItemList"
            }
        },
        {
            "@id": "gag:fullPath",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "fullPath",
            "rdfs:comment": "The absolute file system path of the resource.",
            "rdfs:subPropertyOf": {
                "@id": "schema:contentUrl"
            }
        },
        {
            "@id": "gag:fileAttributes",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "fileAttributes",
            "rdfs:comment": "Platform-specific file attribute flags or modes represented as an integer."
        },
        {
            "@id": "gag:winFileAttributes",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "winFileAttributes",
            "rdfs:comment": "Windows file attribute flags represented as a 32-bit unsigned integer. This corresponds to the FileAttributes field of the FILE_BASIC_INFORMATION structure as defined in winnt.h.",
            "rdfs:subPropertyOf": {
                "@id": "gag:fileAttributes"
            }
        },
        {
            "@id": "gag:posixFileAttributes",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "posixFileAttributes",
            "rdfs:comment": "POSIX file mode and permissions represented as an unsigned integer. This corresponds to the st_mode field of the struct stat as defined in POSIX standards (e.g., sys/stat.h).",
            "rdfs:subPropertyOf": {
                "@id": "gag:fileAttributes"
            }
        },
        {
            "@id": "gag:winFileTimeModified",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "winFileTimeModified",
            "rdfs:comment": "The last modification time represented as a 64-bit Windows FILETIME integer."
        },
        {
            "@id": "gag:winFileTimeCreated",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "winFileTimeCreated",
            "rdfs:comment": "The creation time represented as a 64-bit Windows FILETIME integer."
        },
        {
            "@id": "gag:gitTreeMode",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "gitTreeMode",
            "rdfs:comment": "Git tree object entry mode represented as an unsigned integer. While Git stores this as an octal ASCII string in tree objects, this property represents the value as an integer (currently utilizing up to 17 bits).",
            "rdfs:subPropertyOf": {
                "@id": "gag:fileAttributes"
            }
        },
        {
            "@id": "gag:DirectoryTree",
            "@type": "rdfs:Class",
            "rdfs:label": "Directory Tree",
            "rdfs:comment": "A recursive tree structure where object keys represent path segments (directory or file names) and values are either null (leaf nodes) or nested DirectoryTree objects (directories with contents)."
        },
        {
            "@id": "gag:pathSegment",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Path Segment",
            "rdfs:comment": "A single component of a file system path, representing a directory or file name. Must not contain path separators or invalid filesystem characters.",
            "rdfs:domain": "gag:DirectoryTree"
        },
        {
            "@id": "gag:isReparsePoint",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Is Reparse Point",
            "rdfs:comment": "Boolean indicating whether this directory is a Windows reparse point (junction, symlink, or mount point)."
        },
        {
            "@id": "gag:reparseTag",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Reparse Tag",
            "rdfs:comment": "Windows reparse point tag value identifying the type of reparse point."
        },
        {
            "@id": "gag:isSymlink",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Is Symlink",
            "rdfs:comment": "Boolean indicating whether this is a symbolic link."
        },
        {
            "@id": "gag:isMountPoint",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Is Mount Point",
            "rdfs:comment": "Boolean indicating whether this directory is a mount point for another filesystem."
        },
        {
            "@id": "gag:linkTarget",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Link Target",
            "rdfs:comment": "The target path of a symbolic link or junction."
        },
        {
            "@id": "gag:volumeSerialNumber",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Volume Serial Number",
            "rdfs:comment": "The volume serial number of the filesystem containing this directory."
        },
        {
            "@id": "gag:isEncrypted",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Is Encrypted",
            "rdfs:comment": "Boolean indicating whether this directory or its contents are encrypted."
        },
        {
            "@id": "gag:isRemovable",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Is Removable",
            "rdfs:comment": "Boolean indicating whether this directory is on removable media."
        },
        {
            "@id": "gag:isGitRoot",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Is Git Root",
            "rdfs:comment": "Boolean indicating whether this directory contains a .git directory."
        },
        {
            "@id": "gag:isWorkTree",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Is Work Tree",
            "rdfs:comment": "Boolean indicating whether this directory is a Git worktree."
        },
        {
            "@id": "gag:validationSchema",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Validation Schema",
            "rdfs:comment": "URI of a JSON Schema document that can be used to validate this data. This is a convention for associating JSON-LD data with a JSON Schema, as there is no standard mechanism for this in either specification."
        },
        {
            "@id": "gag:dirtree",
            "@type": "owl:ObjectProperty",
            "rdfs:label": "dirtree",
            "rdfs:comment": "The property that holds the hierarchical Directory Tree structure.",
            "rdfs:range": {
                "@id": "gag:DirectoryTree"
            }
        },
        {
            "@id": "gag:observer",
            "@type": "owl:ObjectProperty",
            "rdfs:label": "observer",
            "rdfs:comment": "The person or agent performing the observation (probe).",
            "rdfs:subPropertyOf": {
                "@id": "prov:wasAssociatedWith"
            }
        },
        {
            "@id": "gag:target",
            "@type": "owl:ObjectProperty",
            "rdfs:label": "target",
            "rdfs:comment": "The system or device being observed (probed).",
            "rdfs:subPropertyOf": {
                "@id": "schema:target"
            }
        },
        {
            "@id": "gag:observedAt",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Observed At",
            "rdfs:comment": "The ISO 8601 timestamp when the observation or scan was performed.",
            "rdfs:subPropertyOf": {
                "@id": "prov:generatedAtTime"
            }
        },
        {
            "@id": "gag:AvailabilityReport",
            "@type": "rdfs:Class",
            "rdfs:label": "Availability Report",
            "rdfs:comment": "A report detailing the accessibility of a set of URLs."
        },
        {
            "@id": "gag:AvailabilitySummary",
            "@type": "rdfs:Class",
            "rdfs:label": "Availability Summary",
            "rdfs:comment": "A summary of the results of an availability check."
        },
        {
            "@id": "gag:availabilitySummary",
            "@type": "owl:ObjectProperty",
            "rdfs:label": "Availability Summary",
            "rdfs:comment": "The summary object containing aggregate metrics of an availability check.",
            "rdfs:range": {
                "@id": "gag:AvailabilitySummary"
            }
        },
        {
            "@id": "gag:availabilityResults",
            "@type": "owl:ObjectProperty",
            "rdfs:label": "Availability Results",
            "rdfs:comment": "A list of individual availability check results.",
            "rdfs:range": {
                "@id": "earl:TestResult"
            }
        },
        {
            "@id": "gag:totalChecks",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Total Checks",
            "rdfs:comment": "The total number of URLs checked."
        },
        {
            "@id": "gag:accessibleCount",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Accessible Count",
            "rdfs:comment": "The number of URLs that were accessible."
        },
        {
            "@id": "gag:inaccessibleCount",
            "@type": "owl:DatatypeProperty",
            "rdfs:label": "Inaccessible Count",
            "rdfs:comment": "The number of URLs that were inaccessible."
        },
        {
            "@id": "gag:redirectHistory",
            "@type": "owl:ObjectProperty",
            "rdfs:label": "Redirect History",
            "rdfs:comment": "A list of URLs followed during redirects."
        }
    ]
}