{
    "@id": "https://purl.org/gag/schema/probe.jsonld",
    "@context": {
        "gag": "https://purl.org/gag/schema/vocab#",
        "schema": "https://schema.org/",
        "ldap": "https://purl.org/net/ldap#",
        "ad": "https://purl.org/identity/ad/",
        "snmp": "http://www.w3.org/ns/snmp#",
        "cim": "http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2/",
        "uid": "ldap:uid",
        "userPrincipalName": "ad:userPrincipalName",
        "sysName": "snmp:sysName",
        "platform": "cim:OSType",
        "osName": "schema:name",
        "osVersion": "schema:softwareVersion",
        "osBuild": "cim:BuildNumber",
        "osArchitecture": "cim:OSArchitecture",
        "kernelVersion": "cim:Version",
        "baseboard": "cim:BaseBoard",
        "manufacturer": "schema:manufacturer",
        "product": "schema:productID",
        "totalPhysicalMemory": "cim:TotalPhysicalMemory",
        "logicalDisks": "cim:LogicalDisk",
        "deviceId": "schema:identifier",
        "size": "schema:contentSize",
        "freeSpace": "cim:FreeSpace"
    }
}